# ──────────────────────────────────────────────────────────────
# Приложение
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Публичный адрес сайта без слэша на конце — используется в canonical и og:url
PUBLIC_URL=https://padali.band

# ──────────────────────────────────────────────────────────────
# База данных
# ──────────────────────────────────────────────────────────────
# PostgreSQL. Внутренний адрес managed-базы в сети Coolify
# (имя сервиса), для локального запуска — 127.0.0.1
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Отдельная схема внутри базы: таблицы приложения не смешиваются
# с таблицами соседних проектов в той же базе
DB_SCHEMA=padali

# ──────────────────────────────────────────────────────────────
# Секреты
# ──────────────────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ──────────────────────────────────────────────────────────────
# Первый администратор (создаётся при старте, если таблица пуста)
# ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Хранилище изображений
# ──────────────────────────────────────────────────────────────
# В Coolify сюда монтируется persistent storage
UPLOAD_DIR=/app/data/uploads
