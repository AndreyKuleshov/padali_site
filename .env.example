# ──────────────────────────────────────────────────────────────
# Приложение
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Публичный адрес сайта без слэша на конце — используется в canonical и og:url
PUBLIC_URL=https://padali.band

# ──────────────────────────────────────────────────────────────
# База данных
# ──────────────────────────────────────────────────────────────
# PostgreSQL. Внутренний адрес managed-базы в сети Coolify
# (имя сервиса), для локального запуска — 127.0.0.1
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Отдельная схема внутри базы: таблицы приложения не смешиваются
# с таблицами соседних проектов в той же базе
DB_SCHEMA=padali

# ──────────────────────────────────────────────────────────────
# Секреты
# ──────────────────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ──────────────────────────────────────────────────────────────
# Первый администратор (создаётся при старте, если таблица пуста)
# ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Хранилище изображений
# ──────────────────────────────────────────────────────────────
# В Coolify сюда монтируется persistent storage
UPLOAD_DIR=/app/data/uploads

# ──────────────────────────────────────────────────────────────
# Перевод текстов в админке (необязательно)
# ──────────────────────────────────────────────────────────────
# Без ключа кнопки «Перевести» просто не показываются.
OPENAI_API_KEY=

# Капча на формах (Cloudflare Turnstile). Пусто — капчи нет, формы
# работают как раньше. Открытый ключ уходит в разметку страницы,
# закрытый живёт только на сервере.
CF_SITE_KEY=
CF_SECRET_KEY=
# Строки короткие, задача простая — берём быструю и дешёвую модель.
# Ещё дешевле и быстрее: gpt-4.1-nano. Качественнее: gpt-4.1.
OPENAI_MODEL=gpt-4.1-mini

# ──────────────────────────────────────────────────────────────
# Почта для форм на сайте (необязательно)
# ──────────────────────────────────────────────────────────────
# Без SMTP_HOST сообщения всё равно сохраняются и видны в разделе
# «Сообщения» админки — просто не уходят письмом.
# Для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, в SMTP_PASSWORD
# не обычный пароль, а «пароль приложения».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Отправитель и получатель
MAIL_FROM=
MAIL_TO=padaliband@gmail.com

# ── Необязательное: значения ниже имеют разумные умолчания ──────

# Сколько прокси стоит перед приложением. За Traefik в Coolify — 1.
# Ошибётесь в большую сторону — адрес посетителя можно подделать,
# в меньшую — все попытки входа сложатся в одну.
TRUSTED_PROXY_HOPS=1

# Ещё администраторы, через запятую: почта:пароль. Заводятся, пока
# таблица admin_users пуста.
ADMIN_USERS=

# Сколько дней держим обезличенную статистику.
ANALYTICS_RETENTION_DAYS=180

# Мастер-копия снимка: предел ширины и качество webp.
MASTER_MAX_WIDTH=2560
MASTER_QUALITY=90

# Таймауты внешних вызовов, миллисекунды.
SMTP_TIMEOUT_MS=8000
OPENAI_TIMEOUT_MS=20000
OPENAI_BASE_URL=https://api.openai.com/v1
