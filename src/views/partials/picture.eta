<%
  var media = it.media
  var sizes = it.sizes || '100vw'
  var className = it.className || ''
  var loading = it.eager ? 'eager' : 'lazy'
%><% if (media) { %><img
  src="<%= media.src %>"
  <% if (media.srcset) { %>srcset="<%= media.srcset %>" sizes="<%= sizes %>"<% } %>
  width="<%= media.width %>" height="<%= media.height %>"
  alt="<%= media.alt %>"
  loading="<%= loading %>" decoding="async"
  <% if (className) { %>class="<%= className %>"<% } %>
  <% ;/* Открывается не только мышью: без tabindex и роли альбом
         нельзя было открыть с клавиатуры вовсе. */ %>
  <% if (it.lightbox) { %>data-lightbox="<%= media.original %>" tabindex="0" role="button"<% } %>
><% } %>
