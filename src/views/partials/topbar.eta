<header class="topbar" data-block="header">
  <div class="wrap topbar-inner">
    <a class="logo-mark<%= it.siteLogo ? ' logo-mark--own' : '' %>"
       href="<%= it.h.localeUrl(it.locale, it.defaultLocale) %>" aria-label="PADALI">
      <% if (it.siteLogo) { %>
      <%~ include('/partials/picture', { media: it.siteLogo, sizes: '160px', eager: true }) %>
      <% } else { %>
      <img src="<%= it.h.asset(it.h.builtInLogo) %>" alt="PADALI" width="916" height="267">
      <% } %>
    </a>
    <div class="topbar-right">
      <% if (it.quicknav.length > 0) { %>
      <% ;/* Кнопка видна только на телефоне: на мониторе разделы
             стоят полосой под шапкой. */ %>
      <button type="button" class="menu-toggle" data-menu-toggle
              aria-controls="sideMenu" aria-expanded="false"
              aria-label="<%= it.s('nav.menu') %>"><%~ it.h.icon('menu') %></button>
      <% } %>
      <% if ((it.settings.social || []).length > 0) { %>
      <nav class="social-row" aria-label="<%= it.s('nav.social') %>">
        <% it.settings.social.forEach(function (link) { %>
        <a href="<%= link.url %>" aria-label="<%= link.label || link.icon %>" target="_blank" rel="noopener">
          <%~ it.h.icon(link.icon) %>
        </a>
        <% }) %>
      </nav>
      <% } %>
      <% if (it.locales.length > 1) { %>
      <% ;/* Показываем оба языка, текущий помечен. Прежде стояла
             одна кнопка с тем языком, на который переключишься, и
             читалась она как «вы сейчас здесь»: по ней судили о
             текущем языке и ошибались. */ %>
      <nav class="lang-switch" aria-label="Language">
        <% it.locales.forEach(function (locale) { %>
        <% if (locale.code === it.locale) { %>
        <span class="lang-btn" aria-current="true"><%= locale.code.toUpperCase() %></span>
        <% } else { %>
        <a class="lang-btn" href="<%= it.h.localeUrl(locale.code, it.defaultLocale) %>" hreflang="<%= locale.code %>"><%= locale.code.toUpperCase() %></a>
        <% } %>
        <% }) %>
      </nav>
      <% } %>
    </div>
  </div>
</header>
