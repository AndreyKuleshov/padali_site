<% ;/* Боковое меню телефона. Лежит рядом с шапкой, а не внутри:
       у .topbar есть backdrop-filter, а он становится точкой
       отсчёта для position: fixed — панель внутри него обрезалась
       бы по высоте шапки.

       Своё имя для статистики: клик учитывается по ближайшему
       data-block, и без него нажатия в меню не считались бы. */ %>
<div class="side-menu" id="sideMenu" data-block="menu" hidden>
  <div class="side-menu-backdrop" data-menu-backdrop></div>
  <aside class="side-menu-panel" role="dialog" aria-modal="true"
         aria-label="<%= it.s('nav.menu') %>">
    <div class="side-menu-head">
      <button type="button" class="side-menu-close" data-menu-close
              aria-label="<%= it.s('common.close') %>"><%~ it.h.icon('close') %></button>
    </div>
    <nav class="side-menu-links">
      <%~ include('/partials/nav-items', it) %>
    </nav>
  </aside>
</div>
