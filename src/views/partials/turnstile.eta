<% ;/* Капча на форме. Разметка одна на обе формы — связи и заказа:
       две копии уже однажды разъехались у переключателя языка, и
       правку в одной вторая пережила незамеченной.

       Ключа нет — нет и капчи: сайт не должен ломаться оттого, что
       её ещё не завели. Скрытое поле с токеном Turnstile кладёт в
       форму сам, отдельного input не нужно. */ %>
<% if (it.h.turnstileSiteKey) { %>
<div class="cf-turnstile"
     data-sitekey="<%= it.h.turnstileSiteKey %>"
     data-theme="dark"
     data-language="<%= it.locale %>"
     data-retry="never"
     <% ;/* Виджета не видно, пока он не понадобится: большинству
            людей проверка проходит молча. Это документированный
            режим Cloudflare, а не скрытие стилями — спрятанный
            через CSS виджет не дал бы пройти тем, кому проверка
            всё-таки выпадет. */ %>
     data-appearance="interaction-only"></div>
<% } %>
