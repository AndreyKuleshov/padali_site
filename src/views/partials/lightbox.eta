<div class="lightbox" id="lightbox" role="dialog" aria-modal="true"
     aria-label="<%= it.s('lightbox.title') %>" hidden>

  <button class="lightbox-close" id="lightboxClose" type="button"
          aria-label="<%= it.s('common.close') %>">&times;</button>

  <button class="lightbox-nav lightbox-nav--prev" id="lightboxPrev" type="button"
          aria-label="<%= it.s('lightbox.previous') %>" hidden>
    <%~ it.h.icon('arrow-left') %>
  </button>

  <button class="lightbox-nav lightbox-nav--next" id="lightboxNext" type="button"
          aria-label="<%= it.s('lightbox.next') %>" hidden>
    <%~ it.h.icon('arrow-right') %>
  </button>

  <figure class="lightbox-figure">
    <img id="lightboxImg" src="" alt="">
    <figcaption id="lightboxCaption"></figcaption>
  </figure>

  <p class="lightbox-counter" id="lightboxCounter" hidden aria-live="polite"></p>
</div>
