<%~ include('/admin/partials/head', Object.assign({}, it, { pageTitle: it.t('media.title') })) %>

<div class="page-head">
  <div>
    <h1><%= it.t('media.title') %></h1>
    <p class="hint"><%= it.t('media.subtitle', { total: it.total }) %></p>
  </div>
</div>

<form class="card upload-form" method="post" action="/admin/media/upload" enctype="multipart/form-data">
  <% ;/* Токен должен идти ДО файла: загрузка читает поток по частям. */ %>
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <div class="upload-drop" id="uploadDrop"
       data-idle="<%= it.t('media.dropHere') %>"
       data-over="<%= it.t('media.dropNow') %>"
       data-ready="<%= it.t('media.readyToUpload', { count: '{count}' }) %>"
       data-remove="<%= it.t('media.removeSelected') %>"
       data-rejected="<%= it.t('media.rejectedType', { names: '{names}' }) %>">
    <input type="file" id="uploadInput" name="files"
           accept="image/jpeg,image/png,image/webp,image/avif" multiple hidden>
    <label class="upload-cta" for="uploadInput">
      <span id="uploadCaption"><%= it.t('media.dropHere') %></span>
    </label>
    <div class="upload-previews" id="uploadPreviews" hidden></div>
    <p class="upload-note" id="uploadNote" role="status" hidden></p>
  </div>

  <button type="submit" class="btn btn--primary"><%= it.t('media.upload') %></button>
</form>

<% if (it.items.length === 0) { %>
<p class="empty"><%= it.t('media.empty') %></p>
<% } else { %>
<div class="media-grid">
  <% it.items.forEach(function (item) { %>
  <article class="media-card">
    <a href="/uploads/<%= item.path %>" target="_blank" rel="noopener">
      <img src="<%= item.thumb %>" alt="" loading="lazy">
    </a>
    <div class="media-meta">
      <strong title="<%= item.originalName %>"><%= item.originalName %></strong>
      <span><%= item.width %>×<%= item.height %>, <%= Math.round(item.bytes / 1024) %> KB</span>
      <span class="<%= item.uses > 0 ? 'uses uses--on' : 'uses' %>">
        <%= item.uses > 0 ? it.t('media.used', { count: item.uses }) : it.t('media.unused') %>
      </span>
    </div>

    <details>
      <summary><%= it.t('common.description') %></summary>
      <form method="post" action="/admin/media/<%= item.id %>" class="stack">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <% ;/* Группируем по смыслу, а не по языку: перевод идёт
               по одному полю сразу на все языки, и его строка
               должна стоять над своей группой. */ %>
        <% ;['alt', 'caption'].forEach(function (key) { %>
        <%~ include('/admin/partials/locale-field', Object.assign({}, it, {
              label: key,
              prefix: 'text',
              key: key,
              field: { input: 'text' },
              values: function (locale, field) {
                return (item.texts[locale] && item.texts[locale][field]) || ''
              }
            })) %>
        <% }) %>
        <button type="submit" class="btn btn--small btn--primary"><%= it.t('common.save') %></button>
      </form>
    </details>

    <form method="post" action="/admin/media/<%= item.id %>/delete" data-confirm="<%= it.t('media.confirmDelete') %>">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <button type="submit" class="btn btn--danger btn--small"<%= item.uses > 0 ? ' disabled title="' + it.t('media.inUseTitle') + '"' : '' %>><%= it.t('common.delete') %></button>
    </form>
  </article>
  <% }) %>
</div>

<%~ include('/admin/partials/pager', Object.assign({}, it, { base: '/admin/media' })) %>
<% } %>

<%~ include('/admin/partials/foot', it) %>
