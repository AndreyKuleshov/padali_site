<%
  ;/* Значения берутся функцией, а не объектом: так их ждёт
     locale-field, и так же их отдаёт экран настроек. */
  function pageText (locale, key) {
    return (it.pageText[locale] && it.pageText[locale][key]) || ''
  }
%>
<%~ include('/admin/partials/head', Object.assign({}, it, { pageTitle: '/' + it.page.slug })) %>

<div class="page-head">
  <div>
    <p class="breadcrumb"><a href="/admin/pages">← <%= it.t('nav.pages') %></a></p>
    <h1>/<%= it.page.slug %></h1>
  </div>
  <% if (it.page.is_published) { %>
  <a class="btn btn--small" href="/<%= it.page.slug %>" target="_blank" rel="noopener"><%= it.t('pages.openSite') %></a>
  <% } %>
</div>

<form method="post" action="/admin/pages/<%= it.page.id %>" class="block-form">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <section class="card">
    <div class="field">
      <label for="slug"><%= it.t('pages.slug') %></label>
      <input id="slug" type="text" name="slug" value="<%= it.page.slug %>"
             maxlength="<%= it.slugMax %>" pattern="[a-z0-9]+(-[a-z0-9]+)*" required autocomplete="off">
      <p class="hint"><%= it.t('pages.slugHint') %></p>
    </div>

    <div class="field">
      <label class="checkbox">
        <input type="checkbox" name="is_published" value="1"<% if (it.page.is_published) { %> checked<% } %>>
        <span><%= it.t('pages.published') %></span>
      </label>
    </div>
  </section>

  <% ;/* Заголовок и описание — то, что видно в выдаче и в
         предпросмотре ссылки. Для страницы, которую рассылают,
         это не мелочь: в чате человек видит сперва их. */ %>
  <section class="card">
    <h2><%= it.t('pages.metaTitle') %></h2>
    <%~ include('/admin/partials/locale-field', Object.assign({}, it, {
          label: it.t('settings.pageTitle'),
          prefix: 'text', key: 'title',
          field: { input: 'text' }, values: pageText
        })) %>
    <%~ include('/admin/partials/locale-field', Object.assign({}, it, {
          label: it.t('settings.pageDescription'),
          prefix: 'text', key: 'description',
          field: { input: 'textarea', rows: 2 }, values: pageText
        })) %>
  </section>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary"><%= it.t('common.save') %></button>
  </div>
</form>

<% ;/* Блоки — на том же экране. Отдельная страница под список
       стоила трёх переходов до добавления блока, и каждый из них
       был поводом передумать. */ %>
<div class="page-head">
  <h2><%= it.t('pages.blocksTitle') %></h2>
  <form method="post" action="/admin/blocks" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <input type="hidden" name="page_id" value="<%= it.page.id %>">
    <select name="type" aria-label="<%= it.t('blocks.type') %>">
      <% it.blockTypes.forEach(function (type) { %>
      <option value="<%= type.type %>"><%= it.localize(type.title) %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn--primary"><%= it.t('blocks.add') %></button>
  </form>
</div>

<% if (it.blocks.length === 0) { %>
<p class="empty"><%= it.t('blocks.empty') %></p>
<% } else { %>
<%~ include('/admin/partials/block-list', it) %>
<% } %>

<%~ include('/admin/partials/foot', it) %>
