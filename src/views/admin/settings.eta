<%
  var social = Array.isArray(it.settings.social) ? it.settings.social : []
  function pageText (locale, key) {
    return (it.pageTexts[locale] && it.pageTexts[locale][key]) || ''
  }
%>
<%~ include('/admin/partials/head', Object.assign({}, it, { pageTitle: it.t('settings.title') })) %>

<div class="page-head"><h1><%= it.t('settings.title') %></h1></div>

<form method="post" action="/admin/settings" class="block-form">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <section class="card">
    <h2><%= it.t('settings.meta') %></h2>
    <div class="field">
      <label><%= it.t('settings.pageTitle') %></label>
      <div class="locale-grid">
        <% it.locales.forEach(function (locale) { %>
        <div>
          <span class="locale-tag"><%= locale.code.toUpperCase() %></span>
          <input type="text" name="text[<%= locale.code %>][title]" value="<%= pageText(locale.code, 'title') %>">
        </div>
        <% }) %>
      </div>
    </div>
    <div class="field">
      <label><%= it.t('settings.pageDescription') %></label>
      <div class="locale-grid locale-grid--stacked">
        <% it.locales.forEach(function (locale) { %>
        <div>
          <span class="locale-tag"><%= locale.code.toUpperCase() %></span>
          <textarea name="text[<%= locale.code %>][description]" rows="2"><%= pageText(locale.code, 'description') %></textarea>
        </div>
        <% }) %>
      </div>
    </div>
    <div class="field">
      <label for="og_image_id"><%= it.t('settings.ogImage') %></label>
      <select id="og_image_id" name="og_image_id">
        <option value=""><%= it.t('settings.ogNone') %></option>
        <% it.library.forEach(function (media) { %>
        <option value="<%= media.id %>"<%= Number(it.settings.og_image_id) === media.id ? ' selected' : '' %>><%= media.name %></option>
        <% }) %>
      </select>
    </div>
  </section>

  <section class="card">
    <h2><%= it.t('settings.logo') %></h2>
    <div class="field" data-logo-field>
      <label><%= it.t('settings.logoCurrent') %></label>
      <div class="media-inherited">
        <% ;/* Адрес встроенного логотипа держим здесь: иначе при
               возврате к нему из списка пришлось бы угадывать его
               по текущему превью, где может стоять загруженный. */ %>
        <div class="media-slot media-slot--preview<%= it.logo.builtIn ? ' media-slot--invert' : '' %>"
             id="logoPreviewBox"
             data-builtin-thumb="<%= it.builtInLogo.thumb %>"
             data-builtin-note="<%= it.t('settings.logoBuiltIn') %>">
          <img src="<%= it.logo.thumb %>" alt="" id="logoPreview">
        </div>
        <p class="hint" id="logoPreviewNote"><%= it.logo.builtIn ? it.t('settings.logoBuiltIn') : it.logo.name %></p>
      </div>

      <label for="logo_id"><%= it.t('settings.logo') %></label>
      <select id="logo_id" name="logo_id">
        <option value=""><%= it.t('settings.logoNone') %></option>
        <% it.library.forEach(function (media) { %>
        <option value="<%= media.id %>"<%= Number(it.settings.logo_id) === media.id ? ' selected' : '' %>
                data-thumb="<%= media.thumb %>"><%= media.name %></option>
        <% }) %>
      </select>
      <div class="media-actions">
        <label class="btn btn--small media-upload" data-logo-upload>
          <%= it.t('blockForm.uploadNew') %>
          <input type="file" accept="image/*" hidden>
        </label>
        <span class="media-upload-note hint" hidden></span>
      </div>
      <p class="hint"><%= it.t('settings.logoHint') %></p>
    </div>
  </section>

  <section class="card">
    <h2><%= it.t('settings.social') %></h2>
    <div class="field repeater" data-repeater="social">
      <div class="repeater-rows">
        <% social.forEach(function (row, index) { %>
        <div class="repeater-row" data-index="<%= index %>">
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.icon') %></span>
            <select name="social[<%= index %>][icon]">
              <% it.iconNames.forEach(function (name) { %>
              <option value="<%= name %>"<%= row.icon === name ? ' selected' : '' %>><%= name %></option>
              <% }) %>
            </select>
          </div>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.label') %></span>
            <input type="text" name="social[<%= index %>][label]" value="<%= row.label || '' %>">
          </div>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.url') %></span>
            <input type="url" name="social[<%= index %>][url]" value="<%= row.url || '' %>">
          </div>
          <button type="button" class="btn btn--danger btn--small repeater-remove">×</button>
        </div>
        <% }) %>
      </div>

      <template data-repeater-template>
        <div class="repeater-row" data-index="__INDEX__">
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.icon') %></span>
            <select name="social[__INDEX__][icon]">
              <% it.iconNames.forEach(function (name) { %>
              <option value="<%= name %>"><%= name %></option>
              <% }) %>
            </select>
          </div>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.label') %></span>
            <input type="text" name="social[__INDEX__][label]" value="">
          </div>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.t('settings.url') %></span>
            <input type="url" name="social[__INDEX__][url]" value="">
          </div>
          <button type="button" class="btn btn--danger btn--small repeater-remove">×</button>
        </div>
      </template>

      <button type="button" class="btn btn--small repeater-add"><%= it.t('settings.addIcon') %></button>
    </div>
  </section>

  <section class="card">
    <h2><%= it.t('settings.footer') %></h2>
    <div class="field">
      <label for="footer_note"><%= it.t('settings.footerNote') %></label>
      <input type="text" id="footer_note" name="footer_note" value="<%= it.settings.footer_note || '' %>">
    </div>
  </section>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary"><%= it.t('common.save') %></button>
  </div>
</form>

<%~ include('/admin/partials/foot', it) %>
