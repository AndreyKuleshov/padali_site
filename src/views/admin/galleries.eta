<%~ include('/admin/partials/head', it) %>

<div class="page-head">
  <div>
    <h1>Альбомы</h1>
    <p class="hint">Альбом — набор фотографий. Чтобы он появился на сайте, вставьте блок «Фотогалерея» и выберите в нём альбом. Один альбом можно вставить в несколько мест.</p>
  </div>
  <form method="post" action="/admin/galleries" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <input type="text" name="slug" placeholder="короткое имя, латиницей" required>
    <button type="submit" class="btn btn--primary">Создать альбом</button>
  </form>
</div>

<% if (it.galleries.length === 0) { %>
<p class="empty">Альбомов пока нет.</p>
<% } else { %>
<ul class="block-list">
  <% it.galleries.forEach(function (gallery) { %>
  <li class="block-row">
    <a class="block-main" href="/admin/galleries/<%= gallery.id %>">
      <span class="block-type"><%= gallery.title || gallery.slug %></span>
      <span class="block-anchor"><%= gallery.slug %></span>
      <span class="block-label"><%= gallery.item_count %> фото</span>
    </a>
  </li>
  <% }) %>
</ul>
<% } %>

<%~ include('/admin/partials/foot', it) %>
