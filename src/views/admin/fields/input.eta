<%
  var field = it.field
  var name = it.name
  var value = it.value
  var id = (name || '').replace(/[\[\]]/g, '_')
  var localize = it.localize || function (v) { return typeof v === 'string' ? v : (v && (v.en || Object.values(v)[0])) || '' }
%>
<% if (field.input === 'textarea' || field.input === 'richtext') { %>
  <textarea id="<%= id %>" name="<%= name %>" rows="<%= field.rows || 4 %>"><%= value || '' %></textarea>

<% } else if (field.input === 'checkbox') { %>
  <label class="check">
    <input type="checkbox" id="<%= id %>" name="<%= name %>" value="on"<%= value ? ' checked' : '' %>>
    <span><%= localize(field.label) %></span>
  </label>

<% } else if (field.input === 'select') { %>
  <select id="<%= id %>" name="<%= name %>">
    <% ;(field.options || []).forEach(function (option) { %>
    <option value="<%= option %>"<%= String(value) === String(option) ? ' selected' : '' %>>
      <%= (field.optionLabels && field.optionLabels[option]) ? localize(field.optionLabels[option]) : option %>
    </option>
    <% }) %>
  </select>

<% } else if (field.input === 'gallery-picker') { %>
  <select id="<%= id %>" name="<%= name %>">
    <option value="">— —</option>
    <% ;(it.galleries || []).forEach(function (gallery) { %>
    <option value="<%= gallery.id %>"<%= Number(value) === gallery.id ? ' selected' : '' %>>
      <%= gallery.title || gallery.slug %> (<%= gallery.item_count %>)
    </option>
    <% }) %>
  </select>

<% } else if (field.input === 'number') { %>
  <input type="number" id="<%= id %>" name="<%= name %>" value="<%= value === 0 || value ? value : '' %>"
    <%= field.min !== undefined ? 'min=' + field.min : '' %>
    <%= field.max !== undefined ? 'max=' + field.max : '' %>>

<% } else if (field.input === 'date') { %>
  <input type="date" id="<%= id %>" name="<%= name %>" value="<%= value || '' %>">

<% } else if (field.input === 'youtube') { %>
  <div class="youtube-field" data-youtube-field
       data-checking="<%= it.t('youtube.checking') %>"
       data-failed="<%= it.t('youtube.checkFailed') %>">
    <input type="text" id="<%= id %>" name="<%= name %>" value="<%= value || '' %>"
           placeholder="https://www.youtube.com/watch?v=…" autocomplete="off">
    <div class="youtube-preview" data-youtube-preview hidden></div>
  </div>

<% } else if (field.input === 'price') { %>
  <% ;/* Имя валюты берём переданное, если оно есть: в строке
         повторителя это «settings[events][1][price_currency]», и
         собственное «settings[price_currency]» склеило бы валюту
         всех строк в одно поле. */ %>
  <%~ include('/admin/partials/price-input', Object.assign({}, it, {
        id: id,
        currencyName: it.currencyName || ('settings[' + field.key + '_currency]')
      })) %>

<% } else if (field.input === 'url') { %>
  <input type="url" id="<%= id %>" name="<%= name %>" value="<%= value || '' %>" placeholder="https://">

<% } else { %>
  <% ;/* Подсказка в пустом поле — то, чем сайт заполнит его сам.
         Словарь отдаём целиком: какой из вариантов показать,
         решает выбор в соседнем поле, а он меняется без
         перезагрузки. */ %>
  <input type="text" id="<%= id %>" name="<%= name %>" value="<%= value || '' %>"
    <% if (it.placeholderFrom && it.placeholders) { %>data-placeholder-from="<%= it.placeholderFrom %>"
    data-placeholders="<%= JSON.stringify(it.placeholders) %>"<% } %>>
<% } %>
