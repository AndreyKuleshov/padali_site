<% ;/* Панель альбома: что внутри, загрузка файлов и выбор из
       медиатеки. Одна и та же под выбором альбома в форме блока
       и во втором шаге окна создания. */ %>
<% ;/* Атрибуты ставятся условием, а не печатью куска разметки.
       Печать экранирует кавычки, и пустой data-album-id приезжал
       в браузер как значение из двух символов &quot; — панель
       принимала его за имя альбома и на каждой форме блока
       ходила за составом несуществующего. */ %>
<div class="album-panel" data-album-panel<% if (it.inDialog) { %> data-album-id=""<% } %><% if (it.itemFields) { %> data-album-fields<% } %> hidden>
  <% ;/* Для какого альбома нарисованы карточки. Сервер сверяет
         это с выбранным и при расхождении их не пишет: иначе
         строки предыдущего альбома затёрли бы новый. */ %>
  <input type="hidden" name="item_album" value="" data-album-stamp>
  <div class="album-strip" data-album-strip></div>
  <p class="hint" data-album-count></p>
  <div class="media-actions">
    <label class="btn btn--small media-upload" data-album-upload>
      <%= it.t('galleries.addPhotos') %>
      <input type="file" accept="image/*" multiple hidden>
    </label>
    <button type="button" class="btn btn--small media-pick" data-album-pick data-multiple="1"><%= it.t('blockForm.pickFromMedia') %></button>
    <span class="media-upload-note hint" data-album-note hidden></span>
  </div>
  <% ;/* Полоса загрузки. Подпись отдельно от процента: процент
         известен только пока уходят байты, а дальше сервер режет
         размеры, и честнее сказать, чего ждём, чем держать
         застывшие сто. */ %>
  <div class="upload-progress" data-album-progress hidden>
    <p class="upload-progress-head">
      <span data-album-progress-label></span>
      <span class="upload-progress-percent" data-album-progress-percent></span>
    </p>
    <div class="upload-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-album-progress-track>
      <span class="upload-progress-bar" data-album-progress-bar></span>
    </div>
  </div>
</div>
