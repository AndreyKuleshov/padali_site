<% ;/* Поле, заполняемое на каждом языке: подпись, строка перевода
       и по полю на язык. Копий этого блока было восемь, и они
       успели разъехаться — у пункта меню стоял голый input мимо
       общего шаблона полей, то есть без textarea и без будущих
       типов ввода.

       Ожидает: label, prefix (text[<язык>] или свой), key, field
       (описание поля для /admin/fields/input), values(locale, key),
       hint. */ %>
<div class="field" data-translate<% if (it.showIfName) { %> data-show-if="<%= it.showIfName %>" data-show-if-value="<%= it.showIfValue %>"<% } %>>
  <label><%= it.label %></label>
  <%~ include('/admin/partials/translate-row', it) %>
  <div class="locale-grid<%= (it.field.input === 'richtext' || it.field.input === 'textarea') ? ' locale-grid--stacked' : '' %>">
    <% it.locales.forEach(function (locale) { %>
    <div>
      <span class="locale-tag"><%= locale.code.toUpperCase() %></span>
      <%~ include('/admin/fields/input', Object.assign({}, it, {
            field: it.field,
            name: it.prefix + '[' + locale.code + '][' + it.key + ']',
            value: it.values(locale.code, it.key),
            placeholders: it.placeholders ? it.placeholders(locale.code) : null,
            placeholderFrom: it.placeholderFrom || ''
          })) %>
    </div>
    <% }) %>
  </div>
  <% ;/* Экранируем: подсказка блока «Текст» перечисляет разрешённые
         теги, и сырой она разбиралась браузером как разметка —
         <p> закрывал абзац, <ul> и <h3> открывали блоки, и форма
         ниже съезжала. */ %>
  <% if (it.hint) { %><p class="hint"><%= it.hint %></p><% } %>
</div>
