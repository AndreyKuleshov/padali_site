<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title || 'Админка' %> — PADALI</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="<%= it.h.asset('/brand/favicon.png') %>">
<link rel="stylesheet" href="<%= it.h.asset('/css/admin.css') %>">
</head>
<body class="admin">
<% if (it.nav) { %>
<header class="admin-top">
  <div class="admin-top-inner">
    <a class="admin-brand" href="/admin">PADALI<span>админка</span></a>
    <nav class="admin-nav">
      <% it.nav.forEach(function (item) { %>
      <a href="<%= item.href %>"<%= item.active ? ' class="active"' : '' %>><%= item.label %></a>
      <% }) %>
    </nav>
    <div class="admin-top-right">
      <a class="admin-view-site" href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button type="submit" class="link-button">Выйти</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="admin-main">
<% if (it.flash) { %>
<p class="flash flash--<%= it.flash.type %>"><%= it.flash.message %></p>
<% } %>
