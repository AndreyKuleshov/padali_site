<!doctype html>
<html lang="<%= it.adminLocale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.t('app.title', { page: it.pageTitle || it.t('nav.blocks') }) %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="<%= it.h.asset('/brand/favicon.png') %>">
<link rel="stylesheet" href="<%= it.h.asset('/css/admin.css') %>">
</head>
<body class="admin">
<% if (it.nav) { %>
<header class="admin-top">
  <div class="admin-top-inner">
    <a class="admin-brand" href="/admin">PADALI<span><%= it.t('app.admin') %></span></a>
    <nav class="admin-nav">
      <% it.nav.forEach(function (item) { %>
      <a href="<%= item.href %>"<%= item.active ? ' class="active"' : '' %>><%= item.label %></a>
      <% }) %>
    </nav>
    <div class="admin-top-right">
      <% if ((it.languages || []).length > 1) { %>
      <nav class="admin-lang" aria-label="<%= it.t('settings.language') %>">
        <% it.languages.forEach(function (lang) { %>
        <a href="<%= lang.href %>"<%= lang.active ? ' class="active"' : '' %>><%= lang.code.toUpperCase() %></a>
        <% }) %>
      </nav>
      <% } %>
      <a class="admin-view-site" href="/" target="_blank" rel="noopener"><%= it.t('nav.viewSite') %></a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button type="submit" class="link-button"><%= it.t('nav.logout') %></button>
      </form>
    </div>
  </div>
</header>
<% } %>
<% ;/* Строки для загрузки из поля: она есть и в формах блоков,
       и в настройках, поэтому носитель общий. */ %>
<% if (it.canTranslate) { %>
<span id="translateStrings" hidden
      data-working="<%= it.t('translate.working') %>"
      data-failed="<%= it.t('translate.failed') %>"></span>
<% } %>
<span id="uploadStrings" hidden
      data-uploading="<%= it.t('blockForm.uploading') %>"
      data-failed="<%= it.t('blockForm.uploadFailed') %>"></span>
<main class="admin-main">
<% if (it.flash) { %>
<p class="flash flash--<%= it.flash.type %>"><%= it.flash.message %></p>
<% } %>
