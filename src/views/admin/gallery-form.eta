<%
  function textValue (locale, key) {
    return (it.texts[locale] && it.texts[locale][key]) || ''
  }
%>
<%~ include('/admin/partials/head', Object.assign({}, it, { pageTitle: it.gallery.slug })) %>

<div class="page-head">
  <div>
    <p class="breadcrumb"><a href="/admin/galleries">← <%= it.t('galleries.title') %></a></p>
    <h1><%= it.gallery.slug %></h1>
    <% if (it.usedIn.length > 0) { %>
    <p class="hint"><%= it.t('galleries.usedIn', { count: it.usedIn.length }) %></p>
    <% } else { %>
    <p class="hint"><%= it.t('galleries.notUsed') %></p>
    <% } %>
  </div>
</div>

<form method="post" action="/admin/galleries/<%= it.gallery.id %>" class="block-form" id="galleryForm">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <section class="card">
    <h2><%= it.t('blockForm.general') %></h2>
    <div class="field">
      <label for="slug"><%= it.t('galleries.shortName') %></label>
      <% ;/* Без pattern: сервер сам приводит имя к короткому виду и
             принимает кириллицу. Браузерная проверка была строже и
             не давала сохранить галерею с уже сохранённым именем —
             даже если правили в ней только фотографии. */ %>
      <input type="text" id="slug" name="slug" value="<%= it.gallery.slug %>" maxlength="128" required>
    </div>

    <%~ include('/admin/partials/locale-field', Object.assign({}, it, {
          label: it.t('galleries.name'),
          prefix: 'text', key: 'title',
          field: { input: 'text' }, values: textValue
        })) %>

    <%~ include('/admin/partials/locale-field', Object.assign({}, it, {
          label: it.t('common.description'),
          prefix: 'text', key: 'description',
          field: { input: 'textarea', rows: 2 }, values: textValue
        })) %>
  </section>

  <section class="card">
    <h2><%= it.t('galleries.photosHeading') %></h2>
    <p class="hint"><%= it.t('galleries.photosHint') %></p>
    <% ;/* Ключ цены с буквой: qs считает «price[7]» индексом
           массива и схлопывает разрывы, теряя привязку к id. */ %>
    <p class="hint"><%= it.t('galleries.priceHint') %></p>

    <div class="gallery-items" id="galleryItems" data-price-label="<%= it.t('galleries.price') %>">
      <% it.items.forEach(function (item) { %>
      <div class="gallery-chip" data-id="<%= item.id %>">
        <img src="<%= item.thumb %>" alt="" loading="lazy">
        <button type="button" class="media-remove" aria-label="<%= it.t('blockForm.remove') %>">×</button>
        <input type="text" class="chip-price" name="price[m<%= item.id %>]" value="<%= item.price %>"
               maxlength="64" placeholder="<%= it.t('galleries.price') %>">
      </div>
      <% }) %>
    </div>

    <input type="hidden" name="items" id="galleryItemsValue" value="<%= it.items.map(function (i) { return i.id }).join(',') %>">
    <button type="button" class="btn btn--small media-pick" data-target="galleryItems" data-multiple="1"><%= it.t('galleries.addFromMedia') %></button>
  </section>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary"><%= it.t('common.save') %></button>
    <a class="btn" href="/admin/galleries"><%= it.t('common.cancel') %></a>
  </div>
</form>

<form method="post" action="/admin/galleries/<%= it.gallery.id %>/delete" data-confirm="<%= it.t('galleries.confirmDelete') %>" class="danger-zone">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <button type="submit" class="btn btn--danger"><%= it.t('galleries.deleteButton') %></button>
</form>

<%~ include('/admin/partials/media-picker', it) %>
<%~ include('/admin/partials/foot', it) %>
