<%
  var block = it.block
  var descriptor = it.descriptor
  var locales = it.locales
  function textValue (locale, key) {
    return (it.texts[locale] && it.texts[locale][key]) || ''
  }
%>
<%~ include('/admin/partials/head', Object.assign({}, it, { pageTitle: it.localize(descriptor.title) })) %>

<div class="page-head">
  <div>
    <p class="breadcrumb"><a href="/admin">← <%= it.t('nav.blocks') %></a></p>
    <h1><%= it.localize(descriptor.title) %></h1>
    <% if (descriptor.description) { %><p class="hint"><%= it.localize(descriptor.description) %></p><% } %>
  </div>
</div>

<form method="post" action="/admin/blocks/<%= block.id %>" class="block-form">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <section class="card">
    <h2><%= it.t('blockForm.general') %></h2>

    <label class="check">
      <input type="checkbox" name="is_visible" value="on"<%= block.isVisible ? ' checked' : '' %>>
      <span><%= it.t('blockForm.showOnSite') %></span>
    </label>

    <div class="field">
      <label><%= it.t('blockForm.navLabel') %></label>
      <div class="locale-grid">
        <% locales.forEach(function (locale) { %>
        <div>
          <span class="locale-tag"><%= locale.code.toUpperCase() %></span>
          <input type="text" name="text[<%= locale.code %>][nav_label]" value="<%= textValue(locale.code, 'nav_label') %>">
        </div>
        <% }) %>
      </div>
      <p class="hint"><%= it.t('blockForm.navLabelHint') %></p>
    </div>
  </section>

  <% if ((descriptor.texts || []).length > 0) { %>
  <section class="card">
    <h2><%= it.t('blockForm.texts') %></h2>
    <% descriptor.texts.forEach(function (field) { %>
    <div class="field">
      <label><%= it.localize(field.label) %></label>
      <div class="locale-grid<%= field.input === 'richtext' || field.input === 'textarea' ? ' locale-grid--stacked' : '' %>">
        <% locales.forEach(function (locale) { %>
        <div>
          <span class="locale-tag"><%= locale.code.toUpperCase() %></span>
          <%~ include('/admin/fields/input', Object.assign({}, it, {
                field: field,
                name: 'text[' + locale.code + '][' + field.key + ']',
                value: textValue(locale.code, field.key)
              })) %>
        </div>
        <% }) %>
      </div>
      <% if (field.hint) { %><p class="hint"><%= it.localize(field.hint) %></p><% } %>
    </div>
    <% }) %>
  </section>
  <% } %>

  <% if ((descriptor.media || []).length > 0) { %>
  <section class="card">
    <h2><%= it.t('blockForm.images') %></h2>
    <% descriptor.media.forEach(function (field) { %>
    <% ;/* Поле без своей картинки не пустует: показываем то, что
           сейчас на сайте, иначе редактор видит пустоту и решает,
           что загрузка сломана. */ %>
    <% var chosen = (it.previews[field.key] || []) %>
    <% var inherited = (chosen.length === 0 && field.fallback === 'siteLogo') ? it.siteLogo : null %>
    <div class="field media-field<%= field.fallback === 'siteLogo' ? ' media-field--logo' : '' %>" data-media-field="<%= field.key %>" data-multiple="<%= field.multiple ? '1' : '' %>">
      <label><%= it.localize(field.label) %><%= field.required ? ' *' : '' %></label>
      <div class="media-slots">
        <% chosen.forEach(function (item) { %>
        <div class="media-slot">
          <img src="<%= item.thumb %>" alt="">
          <input type="hidden" name="media[<%= field.key %>][]" value="<%= item.id %>">
          <button type="button" class="media-remove" aria-label="<%= it.t('blockForm.remove') %>">×</button>
        </div>
        <% }) %>
      </div>
      <% if (inherited) { %>
      <div class="media-inherited">
        <div class="media-slot media-slot--preview<%= inherited.builtIn ? ' media-slot--invert' : '' %>"><img src="<%= inherited.thumb %>" alt=""></div>
        <p class="hint"><%= inherited.builtIn ? it.t('blockForm.logoBuiltIn') : it.t('blockForm.logoFromSettings') %></p>
      </div>
      <% } %>
      <div class="media-actions">
        <button type="button" class="btn btn--small media-pick"><%= it.t('blockForm.pickFromMedia') %></button>
        <label class="btn btn--small media-upload">
          <%= it.t('blockForm.uploadNew') %>
          <input type="file" accept="image/*"<%= field.multiple ? ' multiple' : '' %> hidden>
        </label>
        <span class="media-upload-note hint" hidden></span>
      </div>
    </div>
    <% }) %>
  </section>
  <% } %>

  <% if ((descriptor.settings || []).length > 0) { %>
  <section class="card">
    <h2><%= it.t('blockForm.settings') %></h2>
    <% descriptor.settings.forEach(function (field) { %>

    <% if (field.input === 'repeater') { %>
    <% var rows = Array.isArray(block.settings[field.key]) ? block.settings[field.key] : [] %>
    <div class="field repeater" data-repeater="<%= field.key %>">
      <label><%= it.localize(field.label) %></label>
      <div class="repeater-rows">
        <% rows.forEach(function (row, index) { %>
        <div class="repeater-row" data-index="<%= index %>">
          <% field.fields.forEach(function (sub) { %>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.localize(sub.label) %></span>
            <%~ include('/admin/fields/input', Object.assign({}, it, {
                  field: sub,
                  name: 'settings[' + field.key + '][' + index + '][' + sub.key + ']',
                  value: row[sub.key]
                })) %>
          </div>
          <% }) %>
          <button type="button" class="btn btn--danger btn--small repeater-remove">×</button>
        </div>
        <% }) %>
      </div>

      <template data-repeater-template>
        <div class="repeater-row" data-index="__INDEX__">
          <% field.fields.forEach(function (sub) { %>
          <div class="repeater-cell">
            <span class="cell-label"><%= it.localize(sub.label) %></span>
            <%~ include('/admin/fields/input', Object.assign({}, it, {
                  field: sub,
                  name: 'settings[' + field.key + '][__INDEX__][' + sub.key + ']',
                  value: sub.default
                })) %>
          </div>
          <% }) %>
          <button type="button" class="btn btn--danger btn--small repeater-remove">×</button>
        </div>
      </template>

      <button type="button" class="btn btn--small repeater-add"><%= field.addLabel ? it.localize(field.addLabel) : it.t('blockForm.addRow') %></button>
    </div>

    <% } else if (field.input === 'checkbox') { %>
    <div class="field">
      <%~ include('/admin/fields/input', Object.assign({}, it, {
            field: field,
            name: 'settings[' + field.key + ']',
            value: block.settings[field.key]
          })) %>
      <% if (field.hint) { %><p class="hint"><%= it.localize(field.hint) %></p><% } %>
    </div>

    <% } else { %>
    <div class="field">
      <label for="settings_<%= field.key %>_"><%= it.localize(field.label) %><%= field.required ? ' *' : '' %></label>
      <%~ include('/admin/fields/input', Object.assign({}, it, {
            field: field,
            name: 'settings[' + field.key + ']',
            value: block.settings[field.key],
            galleries: it.galleries
          })) %>
      <% if (field.hint) { %><p class="hint"><%= it.localize(field.hint) %></p><% } %>
      <% if (field.input === 'gallery-picker') { %>
      <p class="hint"><%= it.t('blockForm.galleryHint') %>
        <a href="/admin/galleries"><%= it.t('blockForm.manageAlbums') %></a></p>
      <% } %>
    </div>
    <% } %>

    <% }) %>
  </section>
  <% } %>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary"><%= it.t('common.save') %></button>
    <a class="btn" href="/admin"><%= it.t('common.cancel') %></a>
  </div>
</form>

<%~ include('/admin/partials/media-picker', it) %>
<%~ include('/admin/partials/foot', it) %>
