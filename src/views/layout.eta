<!doctype html>
<html lang="<%= it.locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.meta.title %></title>
<% if (it.meta.description) { %>
<meta name="description" content="<%= it.meta.description %>">
<% } %>
<link rel="icon" href="<%= it.h.asset('/brand/favicon.png') %>">
<meta name="theme-color" content="#0A0A0A">

<link rel="canonical" href="<%= it.h.publicUrl + it.h.localeUrl(it.locale, it.defaultLocale) %>">
<% it.locales.forEach(function (locale) { %>
<link rel="alternate" hreflang="<%= locale.code %>" href="<%= it.h.publicUrl + it.h.localeUrl(locale.code, it.defaultLocale) %>">
<% }) %>
<link rel="alternate" hreflang="x-default" href="<%= it.h.publicUrl + it.h.localeUrl(it.defaultLocale, it.defaultLocale) %>">

<meta property="og:type" content="website">
<meta property="og:title" content="<%= it.meta.title %>">
<meta property="og:description" content="<%= it.meta.description %>">
<meta property="og:url" content="<%= it.h.publicUrl + it.h.localeUrl(it.locale, it.defaultLocale) %>">
<% if (it.ogImage) { %>
<meta property="og:image" content="<%= it.h.publicUrl + it.ogImage %>">
<% } %>
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600&family=Archivo:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= it.h.asset('/css/site.css') %>">

<% ;/* Кто играет и где: без этого концерт не попадает в «События»
       Google. jsonScript экранирует «<», иначе строка из названия
       площадки закрыла бы тег скрипта. */ %>
<% if (it.jsonLd) { %>
<script type="application/ld+json"><%~ it.h.jsonScript(it.jsonLd) %></script>
<% } %>
</head>
<body>

<% ;/* До содержимого было пять нажатий Tab: логотип, три соцссылки,
       переключатель языка. Ссылка видна только при фокусе. */ %>
<a class="skip-link" href="#top"><%= it.s('nav.skipToContent') %></a>

<%~ include('/partials/topbar', it) %>
<% if (it.quicknav.length > 0) { %><%~ include('/partials/side-menu', it) %><% } %>

<main id="top">
<% it.blocks.forEach(function (block, index) {
     if (!block.descriptor) return; %>
  <% ;/* Обёртка нужна карте кликов: по ней клик привязывается
         к блоку и не зависит от размера окна посетителя. */ %>
  <div data-block="<%= block.id %>"><%~ include('/' + block.descriptor.template, Object.assign({}, it, { block: block })) %></div>
<%   if (index === 0 && block.type === 'hero' && it.quicknav.length > 0) { %>
  <%~ include('/partials/quicknav', it) %>
<%   } %>
<% }) %>
<% if (it.quicknav.length > 0 && (it.blocks.length === 0 || it.blocks[0].type !== 'hero')) { %>
  <%~ include('/partials/quicknav', it) %>
<% } %>
</main>

<% if (!it.hasFooterBlock) { %><%~ include('/partials/footer', it) %><% } %>
<%~ include('/partials/lightbox', it) %>

<% ;/* Граница узкого экрана приходит разметкой: в скрипте она
       была написана числом и разъехалась бы со стилями молча. */ %>
<script src="<%= it.h.asset('/js/site.js') %>" data-narrow="<%= it.h.layout.narrow %>" defer></script>
<script src="<%= it.h.asset('/js/analytics.js') %>" defer></script>
</body>
</html>
