<%
  var block = it.block
  var gallery = block.gallery
  var items = gallery ? gallery.items : []
  var columns = Number(block.settings.columns) || 3
  var sr = it.locale === 'sr'
  var order = block.text.order || (sr ? 'Poruči' : 'Order')
  var formTitle = block.text.form_title || (sr ? 'Porudžbina' : 'Order')
  var labelCity = block.text.label_city || (sr ? 'Grad' : 'City')
  /* Вид связи теперь выбирают списком, перечислять их в
     подписи незачем. */
  var labelContact = block.text.label_contact || (sr ? 'Kako da vas nađemo' : 'How we reach you')
  var labelMessage = block.text.label_message || (sr ? 'Poruka (nije obavezno)' : 'Message (optional)')
  var submit = block.text.submit || (sr ? 'Pošalji' : 'Send')
  var close = sr ? 'Zatvori' : 'Close'
%>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>
  <% if (block.text.intro) { %><p class="merch-intro"><%= block.text.intro %></p><% } %>

  <% if (items.length > 0) { %>
  <ul class="merch-grid" style="--merch-columns: <%= columns %>">
    <% items.forEach(function (item) { %>
    <% ;/* Подпись заказа собираем здесь: у снимка может не быть
           названия, и «— 2500 RSD» с висящим тире читается как
           недоделка. */ %>
    <% ;/* Название товара принадлежит альбому. Подпись из
           медиатеки общая на все альбомы, поэтому только запасной
           вариант. */ %>
    <% var name = item.title || item.caption || item.alt || '' %>
    <% var label = name ? name + ' — ' + item.price : item.price %>
    <li class="merch-card">
      <div class="merch-shot">
        <%~ include('/partials/picture', { media: item, sizes: '(max-width: 640px) 50vw, 320px' }) %>
      </div>
      <div class="merch-body">
        <% if (name) { %><span class="merch-name"><%= name %></span><% } %>
        <% ;/* Кнопка только у того, чему назначена цена: остальное
               в альбоме — обычные снимки, заказывать там нечего. */ %>
        <% if (item.price) { %>
        <span class="merch-price"><%= item.price %></span>
        <button type="button" class="button button--small merch-order"
                data-order-item="<%= label %>"><%= order %></button>
        <% } %>
      </div>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <dialog class="order-dialog" data-order-dialog>
    <form class="contact-form" data-send-form data-kind="order"
          data-sent="<%= block.text.sent || (sr ? 'Hvala, javićemo se.' : 'Thanks, we will get back to you.') %>"
          data-failed="<%= block.text.failed || (sr ? 'Nije poslato. Pokušajte ponovo.' : 'Not sent. Please try again.') %>">
      <header class="order-head">
        <strong><%= formTitle %></strong>
        <button type="button" class="button button--ghost button--small" data-order-close><%= close %></button>
      </header>

      <p class="order-item" data-order-label></p>
      <input type="hidden" name="item" data-order-field>

      <label class="field">
        <span><%= labelCity %></span>
        <input type="text" name="city" maxlength="128" required>
      </label>

      <% ;/* Сначала вид связи, потом адрес: «контакт» без уточнения
             люди заполняют как попало, и заказ упирается в тупик.
             Поле ввода оживает после выбора — до него непонятно,
             что туда писать. */ %>
      <div class="field contact-pick" data-contact-pick
           data-invalid="<%= block.text.bad_contact || (sr ? 'Netačna adresa' : 'That address does not look right') %>">
        <span><%= labelContact %></span>
        <div class="contact-row">
          <select name="contact_kind" required>
            <option value=""><%= sr ? '— izaberite —' : '— choose —' %></option>
            <option value="email">E-mail</option>
            <option value="telegram">Telegram</option>
          </select>
          <input type="text" name="contact" maxlength="256" required disabled
                 autocomplete="off" data-contact-value>
        </div>
        <p class="form-note" data-contact-error hidden></p>
      </div>

      <label class="field">
        <span><%= labelMessage %></span>
        <textarea name="message" rows="3" maxlength="4000"></textarea>
      </label>

      <div class="honeypot" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </div>

      <button type="submit" class="button"><%= submit %></button>
      <p class="form-note" data-send-note hidden></p>
    </form>
  </dialog>
</section>
