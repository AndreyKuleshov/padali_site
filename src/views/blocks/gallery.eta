<%
  var block = it.block
  var gallery = block.gallery
  var items = gallery ? gallery.items : []
  var layout = block.settings.layout || 'grid'
  var columns = Number(block.settings.columns) || 3
  var columnsMobile = Number(block.settings.columns_mobile) || 2
  var rows = Number(block.settings.rows) || 0
  var showCaptions = !!block.settings.show_captions
  var useLightbox = block.settings.lightbox !== false

  /* Сетка делится на экраны по columns × rows — но делит их CSS,
     а не этот шаблон. Колонок у монитора и телефона разное число,
     и нарезанные здесь страницы на одном из них оказывались бы
     неполными: два кадра и дыра, а стрелка зовёт листать внутрь
     неё. Тут решается только одно — нужно ли листать вообще. */
  var perPage = columns * rows
  var paged = layout === 'grid' && perPage > 0 && items.length > perPage

  var scrollable = paged || layout === 'strip'

  /* Ширина слота считается от колонки содержимого, а не от экрана.
     Галерея живёт внутри .wrap, поэтому «33vw» заставляло браузер
     качать версию 1280px туда, где нужно 240 — отсюда и долгая
     загрузка. Числа те же, что в стилях: it.h.layout. */
  var L = it.h.layout
  var content = L.wrap - L.gutter * 2
  var gaps = (columns - 1) * L.galleryGap
  var slot = Math.round((content - gaps) / columns)
  var narrowGaps = (columnsMobile - 1) * L.galleryGap

  var sizes = layout === 'strip'
    ? '(max-width: ' + L.narrow + 'px) ' + L.stripVw + 'vw, ' + L.stripMax + 'px'
    : '(max-width: ' + L.narrow + 'px) calc((100vw - ' + (L.gutterNarrow * 2 + narrowGaps) + 'px) / ' + columnsMobile + '), ' +
      '(max-width: ' + L.wrap + 'px) calc((100vw - ' + (L.gutter * 2 + gaps) + 'px) / ' + columns + '), ' +
      slot + 'px'
%>
<% if (items.length > 0) { %>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>
  <% if (block.text.intro) { %><p class="note gallery-intro"><%= block.text.intro %></p><% } %>

  <% ;/* Группа листания охватывает все экраны: полноэкранный просмотр
        ходит по всему альбому, а не по видимой странице. */ %>
  <% ;/* Колонки объявлены на рамке: их читает и сетка без листания,
         и лента экранов — у них разные обёртки. */ %>
  <div class="gallery-frame<%= scrollable ? ' gallery-frame--scrollable' : '' %>"
       style="--gallery-columns: <%= columns %>; --gallery-columns-mobile: <%= columnsMobile %>; --gallery-rows: <%= rows || 1 %>"
       <% if (useLightbox) { %>data-lightbox-group="block-<%= block.id %>"<% } %>>

    <% if (paged) { %>
    <div class="gallery-track gallery" data-gallery-scroll>
      <% items.forEach(function (item) { %>
      <figure class="gallery-item">
        <%~ include('/partials/picture', { media: item, sizes: sizes, lightbox: useLightbox, className: 'gallery-image' }) %>
        <% if (showCaptions && item.caption) { %><figcaption><%= item.caption %></figcaption><% } %>
      </figure>
      <% }) %>
    </div>

    <% } else { %>
    <div class="gallery gallery--<%= layout %>"
         <% if (layout === 'strip') { %>data-gallery-scroll<% } %>>
      <% items.forEach(function (item) { %>
      <figure class="gallery-item">
        <%~ include('/partials/picture', { media: item, sizes: sizes, lightbox: useLightbox, className: 'gallery-image' }) %>
        <% if (showCaptions && item.caption) { %><figcaption><%= item.caption %></figcaption><% } %>
      </figure>
      <% }) %>
    </div>
    <% } %>

    <% if (scrollable) { %>
    <button class="gallery-arrow gallery-arrow--prev" type="button" hidden
            aria-label="<%= it.s('gallery.previous') %>">
      <%~ it.h.icon('arrow-left') %>
    </button>
    <button class="gallery-arrow gallery-arrow--next" type="button" hidden
            aria-label="<%= it.s('gallery.next') %>">
      <%~ it.h.icon('arrow-right') %>
    </button>
    <% } %>
  </div>

  <% if (gallery.totalCount > items.length) { %>
  <p class="gallery-more note">
    <%= it.s('gallery.showing') %> <%= items.length %>
    <%= it.s('gallery.of') %> <%= gallery.totalCount %>
  </p>
  <% } %>
</section>
<% } %>
