<%
  var block = it.block
  var email = String(block.settings.email || '').trim()
  var labelMessage = block.text.label_message || it.s('contact.message')
  /* Вид связи выбирают переключателем, перечислять их в подписи
     незачем. */
  var labelContact = block.text.label_contact || it.s('contact.contact')
  var submit = block.text.submit || it.s('form.submit')
%>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>
  <% if (block.text.intro) { %><p class="contact-intro"><%= block.text.intro %></p><% } %>

  <% if (email) { %>
  <p class="contact-email"><a href="mailto:<%= email %>"><%= email %></a></p>
  <% } %>

  <% if (block.settings.show_form) { %>
  <form class="contact-form" data-send-form data-kind="contact"
        data-sent="<%= block.text.sent || it.s('contact.sent') %>"
        data-failed="<%= block.text.failed || it.s('contact.failed') %>">
    <label class="field">
      <span><%= labelMessage %></span>
      <textarea name="message" rows="5" required maxlength="4000"></textarea>
    </label>

    <%~ include('/partials/contact-pick', Object.assign({}, it, {
          label: labelContact,
          invalidText: block.text.bad_contact || it.s('form.badContact')
        })) %>

    <% ;/* Приманка для роботов: человек её не видит, а заполненная
           она отбрасывает отправку. Прячем стилем, а не hidden:
           часть ботов пропускает скрытые атрибутом поля. */ %>
    <div class="honeypot" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    <button type="submit" class="button"><%= submit %></button>
    <p class="form-note" data-send-note hidden></p>
  </form>
  <% } %>
</section>
