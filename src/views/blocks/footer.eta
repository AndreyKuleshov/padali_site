<%
  var block = it.block
  var logo = block.first('logo') || it.siteLogo
  ;/* Своё поле главнее, пустое подхватывает настройки сайта — так
     же, как логотип. Иначе одни и те же три адреса приходится
     держать в двух местах, и подвал молча пустеет, когда их забыли
     вписать второй раз. */
  var own = block.settings.links || []
  var links = own.length > 0 ? own : (it.settings.social || [])
%>
<footer class="wrap site-footer"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.settings.show_logo) { %>
    <% if (logo) { %>
    <span class="site-footer-logo"><%~ include('/partials/picture', { media: logo, sizes: '160px' }) %></span>
    <% } else { %>
    <img src="<%= it.h.asset(it.h.builtInLogo) %>" alt="PADALI" width="916" height="267">
    <% } %>
  <% } %>

  <% if (links.length > 0) { %>
  <ul class="site-footer-links">
    <% links.forEach(function (link) { %>
    <li><a href="<%= link.url %>" target="_blank" rel="noopener" aria-label="<%= link.label %>"><%~ it.h.icon(link.icon) %></a></li>
    <% }) %>
  </ul>
  <% } %>

  <% if (block.text.note) { %><span><%= block.text.note %></span><% } %>
  <% ;/* Год не вписывают руками: вписанный однажды, он молча
         устаревает каждый январь. */ %>
  <span class="site-footer-copy">© <span data-year><%= it.h.year() %></span></span>
</footer>
