<%
  var block = it.block
  var events = Array.isArray(block.settings.events) ? block.settings.events : []
  /* Листаем только когда есть что: один концерт — просто карточка,
     без ленты и стрелок. */
  var many = events.length > 1
%>
<% if (events.length > 0) { %>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>

  <% ;/* Та же лента, что у фотографий: прокрутка с примагничиванием,
         стрелки для мыши, свайп на телефоне. Разметка общая со
         скриптом initGalleryScrollers — он находит ленту по
         data-gallery-scroll. */ %>
  <div class="gallery-frame<%= many ? ' gallery-frame--scrollable' : '' %> concert-frame"
       style="--gallery-columns: 1; --gallery-columns-mobile: 1; --gallery-rows: 1">
    <div class="<%= many ? 'gallery-track ' : '' %>concert-list"<% if (many) { %> data-gallery-scroll<% } %>>
      <% events.forEach(function (event) { %>
      <% var atDoor = event.tickets === 'door' %>
      <% ;/* Пока ничего не известно — ни кнопки, ни цены, даже
             если в полях что-то осталось от прежнего способа
             продажи: показать старую ссылку хуже, чем не
             показать ничего. */ %>
      <% var noTickets = event.tickets === 'unknown' %>
      <div class="concert-grid<%= event.poster ? '' : ' concert-grid--no-poster' %>">
        <% if (event.poster) { %>
        <% ;/* Афиши приходят и стоячие, и лежачие, и ряд из них
               выглядел рваным. Кадр вписывается целиком, а пустоту
               вокруг заполняет он же, размытый: так не срезается
               край афиши и не скачет высота. Оба снимка — один и
               тот же файл, браузер качает его один раз. */ %>
        <div class="poster-box">
          <%~ include('/partials/picture', { media: event.poster, sizes: '(max-width: ' + it.h.layout.narrow + 'px) 100vw, 200px', className: 'poster-blur', decorative: true }) %>
          <%~ include('/partials/picture', { media: event.poster, sizes: '(max-width: ' + it.h.layout.narrow + 'px) 100vw, 200px', lightbox: true }) %>
        </div>
        <% } %>
        <div class="concert-card">
          <% if (event.date) { %>
          <p class="concert-date"><time datetime="<%= event.date %>"><%= it.h.formatDate(event.date) %></time></p>
          <% } %>
          <% if (event.venue) { %><p class="concert-venue"><%= event.venue %></p><% } %>
          <% if (event.note) { %><p class="note"><%= event.note %></p><% } %>

          <% if (!noTickets && (atDoor || event.ticket_url || event.price)) { %>
          <div class="concert-tickets">
            <% if (atDoor) { %>
            <p class="concert-door"><%~ it.h.icon('ticket') %><%= event.ticket_label || it.s('concert.atDoor') %></p>
            <% } else if (event.ticket_url) { %>
            <a class="button" href="<%= event.ticket_url %>" target="_blank" rel="noopener">
              <%~ it.h.icon('ticket') %><%= event.ticket_label || it.s('concert.tickets') %>
            </a>
            <% } %>
            <% if (event.price) { %>
            <span class="concert-price"><%= event.price_from ? it.s('concert.priceFrom') + ' ' + event.price : event.price %></span>
            <% } %>
          </div>
          <% } %>

          <% if (event.tag) { %><p><span class="concert-tag"><%= event.tag %></span></p><% } %>
        </div>
      </div>
      <% }) %>
    </div>

    <% if (many) { %>
    <button class="gallery-arrow gallery-arrow--prev" type="button" hidden
            aria-label="<%= it.s('gallery.previous') %>"><%~ it.h.icon('arrow-left') %></button>
    <button class="gallery-arrow gallery-arrow--next" type="button" hidden
            aria-label="<%= it.s('gallery.next') %>"><%~ it.h.icon('arrow-right') %></button>
    <% } %>
  </div>
</section>
<% } %>
