<%
  var block = it.block
  var poster = block.first('poster')
  /* Билеты на входе: ссылку не показываем, даже если она осталась
     заполненной с прошлого концерта. */
  var atDoor = block.settings.tickets === 'door'
%>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>
  <div class="concert-grid<%= poster ? '' : ' concert-grid--no-poster' %>">
    <% if (poster) { %>
    <div class="poster-box">
      <%~ include('/partials/picture', { media: poster, sizes: '(max-width: ' + it.h.layout.narrow + 'px) 100vw, 200px', lightbox: true }) %>
    </div>
    <% } %>
    <div class="concert-card">
      <% if (block.settings.date) { %>
      <p class="concert-date"><time datetime="<%= block.settings.date %>"><%= it.h.formatDate(block.settings.date) %></time></p>
      <% } %>
      <% if (block.text.venue) { %><p class="concert-venue"><%= block.text.venue %></p><% } %>
      <% if (block.text.note) { %><p class="note"><%= block.text.note %></p><% } %>
      <% ;/* Цена нужна в обоих случаях: и когда билеты продают по
             ссылке, и когда их берут на входе. */ %>
      <% if (block.settings.price) { %>
      <p class="concert-price"><%= block.settings.price %></p>
      <% } %>

      <% if (atDoor) { %>
      <p class="concert-door"><%~ it.h.icon('ticket') %><%= block.text.ticket_label || it.s('concert.atDoor') %></p>
      <% } else if (block.settings.ticket_url) { %>
      <a class="button" href="<%= block.settings.ticket_url %>" target="_blank" rel="noopener">
        <%~ it.h.icon('ticket') %><%= block.text.ticket_label || it.s('concert.tickets') %>
      </a>
      <% } %>
      <% if (block.text.tag) { %><p><span class="concert-tag"><%= block.text.tag %></span></p><% } %>
    </div>
  </div>
</section>
