<%
  var block = it.block
  var events = Array.isArray(block.settings.events) ? block.settings.events : []
%>
<% if (events.length > 0) { %>
<section class="section wrap"<% if (block.anchor) { %> id="<%= block.anchor %>"<% } %>>
  <% if (block.text.heading) { %><h2><%= block.text.heading %></h2><% } %>

  <% ;/* Ближайший концерт — карточка целиком, остальные — строки:
         дата, площадка, цена. Лентой это было нельзя: в ряду сетки
         все карточки тянутся по самой высокой, и у короткого
         концерта шапка расползалась на пустую коробку. Да и даты
         нужны все сразу — ради них сюда и приходят.

         Строка разворачивается в ту же карточку. Разворачивает её
         <details>: без скрипта, с клавиатуры, и поиск по странице
         находит текст внутри свёрнутого. Заодно это держит обещание
         разметки для поисковика — описание и афиша остаются на
         странице, а не исчезают ради краткости. */ %>
  <div class="concert-list">
    <% events.forEach(function (event, index) { %>
    <% ;/* Площадка одной строкой: название и город. Страна в ней
           не нужна — все концерты пока в одной, а «Beograd,
           Serbia» на сербской странице читается как перевод для
           иностранца. */ %>
    <%
      var place = [event.venueName, event.venueCity].filter(Boolean).join(', ')
      /* Разворачивать нечего, если афиши, рассказа и билетов нет:
         у объявленной даты бывает только дата. */
      var details = Boolean(event.poster || event.description || event.eventUrl ||
        event.soldOut || event.ticketUrl || event.price || event.isFree)
      var price = event.price
        ? (event.priceFrom ? it.s('concert.priceFrom') + ' ' + event.price : event.price)
        : ''
      var state = event.soldOut ? it.s('concert.soldOut')
        : event.isFree ? it.s('concert.free')
        : event.ticketUrl && !price ? it.s('concert.tickets') : ''
    %>

    <% if (index === 0) { %>
    <div class="concert">
      <% ;/* Шапка ближайшего: дата, под ней площадка. Билеты не
             здесь, а подвалом подробностей — три коротких строки
             одна под другой оставляли две трети ширины пустыми. */ %>
      <div class="concert-head">
        <% ;/* В datetime — время площадки как есть, без смещения:
               другого у Bandsintown и нет, а выдуманный пояс сдвинул
               бы концерт на час в чужом календаре. */ %>
        <p class="concert-date">
          <time datetime="<%= event.startsAt %>"><%= it.h.formatDate(event.date) %></time>
          <% if (event.time) { %><span class="concert-time"><%~ it.h.icon('clock') %><%= event.time %></span><% } %>
        </p>
        <% if (place) { %><p class="concert-venue"><%= place %></p><% } %>
      </div>
      <% if (details) { %><%~ include('/partials/concert-details', { event: event, s: it.s, h: it.h }) %><% } %>
    </div>

    <% } else if (details) { %>
    <details class="concert concert--row">
      <summary class="concert-row">
        <span class="concert-date">
          <time datetime="<%= event.startsAt %>"><%= it.h.formatDate(event.date) %></time>
          <% if (event.time) { %><span class="concert-time"><%= event.time %></span><% } %>
        </span>
        <% if (place) { %><span class="concert-venue"><%= place %></span><% } %>
        <% if (state) { %><span class="concert-row-state"><%= state %></span>
        <% } else if (price) { %><span class="concert-price"><%= price %></span><% } %>
        <span class="concert-row-sign"><%~ it.h.icon('arrow-right') %></span>
      </summary>
      <%~ include('/partials/concert-details', { event: event, s: it.s, h: it.h }) %>
    </details>

    <% } else { %>
    <% ;/* Разворачивать нечего — строка остаётся строкой, без
           значка и без лишнего обещания. */ %>
    <div class="concert concert--row">
      <div class="concert-row">
        <span class="concert-date">
          <time datetime="<%= event.startsAt %>"><%= it.h.formatDate(event.date) %></time>
          <% if (event.time) { %><span class="concert-time"><%= event.time %></span><% } %>
        </span>
        <% if (place) { %><span class="concert-venue"><%= place %></span><% } %>
      </div>
    </div>
    <% } %>
    <% }) %>
  </div>
</section>
<% } %>
