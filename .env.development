# Локальная разработка. Никаких настоящих секретов здесь нет и быть не должно —
# файл лежит в git, чтобы `npm run dev` работал сразу после клонирования.
# Postgres поднимается командой из README.
NODE_ENV=development
PORT=3031
PUBLIC_URL=http://localhost:3031

DB_HOST=127.0.0.1
DB_PORT=54321
DB_NAME=padali
DB_USER=padali
DB_PASSWORD=padalidev
DB_SCHEMA=padali

SESSION_SECRET=dev-only-secret-not-for-production-0123456789abcdef

ADMIN_EMAIL=admin@padali.local
ADMIN_PASSWORD=padali-dev

UPLOAD_DIR=./data/uploads

# Официальные тестовые ключи Cloudflare: работают с любого домена,
# включая localhost, и всегда пропускают. Секретами не являются —
# они опубликованы в документации Turnstile.
CF_SITE_KEY=1x00000000000000000000AA
CF_SECRET_KEY=1x0000000000000000000000000000000AA
