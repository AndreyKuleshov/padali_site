# Зависимости
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Окружение
# Именно «.env», без звёздочки: .env.development, .env.test и
# .env.example лежат в git намеренно — там только параметры
# локальной базы. «.env*» выкинул бы и их.
.env
.env.local
.env.*.local
.env.production

# Данные приложения
# data/uploads — том с загруженными фотографиями, data/pg — база
# из docker compose. В репозитории им делать нечего.
data/

# Журналы
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Тесты и покрытие
coverage/
.nyc_output/
*.lcov

